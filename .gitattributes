# Notes are the product. Normalise line endings and keep diffs readable.
*.md   text eol=lf diff=markdown
*.py   text eol=lf diff=python
*.sh   text eol=lf
*      text=auto

# Never let a merge driver mangle an append-only log silently.
# Paths must match the live layout: a merge=union rule against a folder that no
# longer exists is silently inert, which is how the history log lost its rule.
log/**                  merge=union
tech/kb/kb-history.md   merge=union
