#!/usr/bin/env bash
# Refuse the commit if the repo does not lint.
#
# Enabled per repo with:  git config core.hooksPath .githooks
# Bypass in a genuine emergency with:  git commit --no-verify
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

if [ ! -f "$REPO_ROOT/scripts/lint.py" ]; then
  echo "pre-commit: scripts/lint.py is missing; refusing to commit blind" >&2
  exit 1
fi

# In a git-crypt repo, prove every staged encrypted blob decrypts BEFORE it is
# committed. `git-crypt status` is not an integrity check; a corrupt blob sits
# undetected on any machine that is already unlocked, and only a fresh clone or
# re-unlock ever finds it — as happened on 2026-09-06.
if [ -d "$REPO_ROOT/.git-crypt" ] || git -C "$REPO_ROOT" config --get filter.git-crypt.clean >/dev/null 2>&1; then
  bad=0
  for f in $(git -C "$REPO_ROOT" diff --cached --name-only --diff-filter=AM); do
    hdr=$(git -C "$REPO_ROOT" cat-file -p ":$f" 2>/dev/null | head -c 9 | xxd -p)
    [ "$hdr" = 004749544352595054 ] || continue
    git -C "$REPO_ROOT" cat-file -p ":$f" | git-crypt smudge >/dev/null 2>&1 || { echo "pre-commit: staged blob does not decrypt — $f" >&2; bad=1; }
  done
  [ "$bad" = 0 ] || { echo "pre-commit: refusing to commit corrupt ciphertext" >&2; exit 1; }
fi

if ! python3 "$REPO_ROOT/scripts/lint.py" --quiet; then
  echo >&2
  echo "pre-commit: lint failed, commit aborted." >&2
  echo "Fix the problems above, or use --no-verify if you truly must." >&2
  exit 1
fi
